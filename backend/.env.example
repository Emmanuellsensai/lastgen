# Lastgen backend environment.
#
# Copy this file to `.env` (same directory) and fill in the values, or export
# the variables in your shell. The `.env` file is git-ignored — secrets must
# never be committed. Everything here is optional for demo mode: the backend
# boots without Supabase, Gemini or ALAT keys and degrades gracefully.

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

# Port the API listens on.
PORT=8080

# Pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Comma-separated list of origins allowed by CORS (the Vite dev server).
CORS_ORIGIN=http://localhost:5173

# Demo mode skips authentication entirely so the full flow runs without
# signing in. Set to false (or unset) to enforce Supabase bearer tokens.
DEMO_MODE=true

# ---------------------------------------------------------------------------
# Supabase (database + auth) — required for live mode and Phase 6 integration
# ---------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Supabase service-role key (server-side only). Never expose this to the
# frontend. Required for the Supabase repository and for token verification.
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# Receipt vision (Gemini) — optional
# ---------------------------------------------------------------------------

# When set, receipt uploads are parsed with gemini-1.5-flash. Without a key the
# backend falls back to a deterministic mock so the demo never blocks.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Payments — simulated | alat
# ---------------------------------------------------------------------------

# Payment provider used by the API. `simulated` is fully in-process and is the
# default for demos and tests; `alat` talks to the real ALAT gateway.
PAYMENT_ADAPTER=simulated

# ALAT gateway details. Only read when PAYMENT_ADAPTER=alat.
ALAT_BASE_URL=https://alat.ng
ALAT_CHANNEL_ID=
ALAT_API_KEY=

# Merchant Wema/ALAT account debited by transfer-fund-request. Only read when
# PAYMENT_ADAPTER=alat.
ALAT_SOURCE_ACCOUNT=

# Simulated adapter auto-settle delay (ms). 0 settles synchronously (tests);
# the demo sets 3000 so the "waiting for you to approve" state is visible.
SETTLE_AFTER_MS=3000