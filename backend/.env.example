# Backend environment variables
# Copy to .env for local development.

# Server port (default: 8080)
PORT=8080

# CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:5173

# Logging level
LOG_LEVEL=info

# Demo mode: true = in-memory repository, unauthenticated, simulated payments
DEMO_MODE=true

# Payment adapter: 'simulated' (default) or 'alat'
PAYMENT_ADAPTER=simulated

# Simulated adapter auto-settle delay (ms). 0 = sync, 3000 = shows auth wait
SETTLE_AFTER_MS=0

# Supabase (required for live mode, ignored in demo mode)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gemini Vision API key (for receipt extraction, optional)
GEMINI_API_KEY=

# ALAT API credentials (required when PAYMENT_ADAPTER=alat)
ALAT_BASE_URL=
ALAT_CHANNEL_ID=
ALAT_API_KEY=
ALAT_SOURCE_ACCOUNT=
ALAT_AMOUNT_UNIT=kobo
