# esbuild and msw postinstall scripts crash with a DLL init error on Windows
# under Node 24. The installed packages work without them (esbuild ships a
# prebuilt binary via @esbuild/win32-x64), so all lifecycle scripts are skipped.
#
# This is a repo-wide install policy and is committed on purpose: a fresh clone
# must install identically on every platform. pnpm-workspace.yaml also lists
# allowBuilds for esbuild/msw — that whitelist is inert while ignore-scripts is
# set, but stays as a guard for anyone who removes this file.
ignore-scripts=true